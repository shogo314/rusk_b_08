enum Option<T> { Some(T), None, }
// Runtime for built-in containers. Not a user-defined generics facility.
extern symbol __runtime_collections__ {
    code: "#include <vector>\n#include <algorithm>\n#include <unordered_map>\n#include <sstream>\n#include <iomanip>\ntemplate<class T> struct RuskVec : std::vector<Obj<T>> {\n    using std::vector<Obj<T>>::vector;\n    std::uint64_t version = 0;\n};\nusing IntVec = RuskVec<std::int64_t>;\ninline std::size_t checked_index(std::size_t size, std::int64_t index, Loc loc) {\n    __int128 position = index;\n    if (position < 0) position += static_cast<__int128>(size);\n    if (position < 0 || position >= static_cast<__int128>(size)) fail(loc, \"array index out of range\");\n    return static_cast<std::size_t>(position);\n}\ninline std::size_t vec_int_index(const IntVec& a, std::int64_t i, Loc loc) { return checked_index(a.size(), i, loc); }\ntemplate<class T> Obj<T> deep_copy(const Obj<T>& x, [[maybe_unused]] Loc loc = Loc{\"<copy>\",0,0}) { return make_obj<T>(*x); }\ntemplate<class T> Obj<RuskVec<T>> deep_copy(const Obj<RuskVec<T>>& x, Loc loc = Loc{\"<copy>\",0,0}) {\n    auto result = make_obj<RuskVec<T>>(RuskVec<T>{});\n    result->reserve(x->size());\n    for (const auto& element : *x) result->push_back(deep_copy(element,loc));\n    return result;\n}\ntemplate<class T> struct RuskIter { Obj<RuskVec<T>> owner; std::size_t index; std::uint64_t version; };\ntemplate<class T> void check_iter(const Obj<RuskIter<T>>& it, Loc loc) {\n    if(it->owner->version != it->version) fail(loc,\"container changed during iteration\");\n}\nstruct RuskRange { std::int64_t start, end; };\nstruct RuskRangeIter { std::int64_t next, end; };\ninline std::unordered_map<const std::string*, std::size_t> string_borrows;\ninline void check_string_resize(const Obj<std::string>& s, Loc loc) {\n    if (string_borrows.contains(s.get())) fail(loc,\"string has active character references\");\n}\ninline Obj<char> string_get(const Obj<std::string>& s, std::int64_t i, Loc loc) {\n    auto position=checked_index(s->size(),i,loc);\n    ++string_borrows[s.get()];\n    return Obj<char>(&(*s)[position],[s](char*){ auto it=string_borrows.find(s.get()); if(--it->second==0) string_borrows.erase(it); });\n}\ninline char checked_char(__int128 value, Loc loc) {\n    if(value<0 || value>127) fail(loc,\"character out of ASCII range\");\n    return static_cast<char>(value);\n}\ntemplate<class T> Obj<T> read_value(Loc loc);\ntemplate<> inline Obj<std::int64_t> read_value(Loc loc) {\n    auto token=read_token(loc); const char* first=token.data(); const char* last=first+token.size();\n    if(first!=last && *first=='+') { ++first; if(first==last || *first<'0'||*first>'9') fail(loc,\"invalid integer input\"); }\n    std::int64_t n=0; auto result=std::from_chars(first,last,n);\n    if(result.ec!=std::errc{}||result.ptr!=last) fail(loc,\"invalid or out of range integer input\");\n    return make_obj<std::int64_t>(n);\n}\ntemplate<> inline Obj<std::string> read_value(Loc loc) { auto s=read_token(loc); require_ascii(s,loc); return make_obj<std::string>(s); }\ntemplate<> inline Obj<char> read_value(Loc loc) {\n    while(ascii_space(rusk_peek())) rusk_get(); int c=rusk_get();\n    if(c<0||c>127) fail(loc,\"invalid character input\"); return make_obj<char>(static_cast<char>(c));\n}\ntemplate<> inline Obj<bool> read_value(Loc loc) {\n    auto s=read_token(loc); if(s==\"Yes\"||s==\"true\"||s==\"1\") return make_obj<bool>(true);\n    if(s==\"No\"||s==\"false\"||s==\"0\") return make_obj<bool>(false); fail(loc,\"invalid boolean input\");\n}\n",
}

// Sequences retain Bool element ordering without adding Bool scalar ordering.
extern fn sequence_element_less<T>(a:T,b:T)->Bool {
    effects:"read_fresh",
    lower:"@{if_type T matches Bool}(!*$0&&*$1)@{else}@{value_call __lt__(T,T)->Bool}($0,$1,$loc)@{end}",
    code:"Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(@{if_type T matches Bool}(!*a&&*b)@{else}@{value_call __lt__(T,T)->Bool}(a,b,loc)@{end});}",
}

extern fn product_equal_body<T>(a:T,b:T)->Bool {
    derive:"tuple_eq",
    effects:"read_fresh",
    lower:"([&](){auto compare=[&](const auto& left,const auto& right){@{fields T as F,I}{bool equal;if constexpr(@{writes __eq__(F,F)->Bool}){{auto x=left->field_@{index I};auto y=right->field_@{index I};equal=@{value_call __eq__(F,F)->Bool}(x,y,$loc);}}else{equal=@{value_call __eq__(F,F)->Bool}(left->field_@{index I},right->field_@{index I},$loc);}if(!equal)return false;}@{end}return true;};if constexpr(@{writes __eq__(T,T)->Bool}){auto left=$0;auto right=$1;return compare(left,right);}else return compare($0,$1);}())",
    code:"Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(([&](){auto& left=a;auto& right=b;@{fields T as F,I}{bool equal;if constexpr(@{writes __eq__(F,F)->Bool}){{auto x=left->field_@{index I};auto y=right->field_@{index I};equal=@{value_call __eq__(F,F)->Bool}(x,y,loc);}}else{equal=@{value_call __eq__(F,F)->Bool}(left->field_@{index I},right->field_@{index I},loc);}if(!equal)return false;}@{end}return true;}()));}",
}

extern fn product_less_body<T>(a:T,b:T)->Bool {
    derive:"tuple_lt",
    effects:"read_fresh",
    lower:"([&](){auto compare=[&](const auto& left,const auto& right){@{fields T as F,I}{int decision=0;if constexpr(@{writes sequence_element_less(F,F)->Bool}){{auto x=left->field_@{index I};auto y=right->field_@{index I};if(@{value_call sequence_element_less(F,F)->Bool}(x,y,$loc))decision=1;else if(@{value_call sequence_element_less(F,F)->Bool}(y,x,$loc))decision=-1;}}else{if(@{value_call sequence_element_less(F,F)->Bool}(left->field_@{index I},right->field_@{index I},$loc))decision=1;else if(@{value_call sequence_element_less(F,F)->Bool}(right->field_@{index I},left->field_@{index I},$loc))decision=-1;}if(decision)return decision>0;}@{end}return false;};if constexpr(@{writes __lt__(T,T)->Bool}){auto left=$0;auto right=$1;return compare(left,right);}else return compare($0,$1);}())",
    code:"Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(([&](){auto& left=a;auto& right=b;@{fields T as F,I}{int decision=0;if constexpr(@{writes sequence_element_less(F,F)->Bool}){{auto x=left->field_@{index I};auto y=right->field_@{index I};if(@{value_call sequence_element_less(F,F)->Bool}(x,y,loc))decision=1;else if(@{value_call sequence_element_less(F,F)->Bool}(y,x,loc))decision=-1;}}else{if(@{value_call sequence_element_less(F,F)->Bool}(left->field_@{index I},right->field_@{index I},loc))decision=1;else if(@{value_call sequence_element_less(F,F)->Bool}(right->field_@{index I},left->field_@{index I},loc))decision=-1;}if(decision)return decision>0;}@{end}return false;}()));}",
}

extern fn product_not_equal_body<T>(a:T,b:T)->Bool {
    derive:"tuple_ne",
    effects:"read_fresh",
    lower:"!@{value_call __eq__(T,T)->Bool}($0,$1,$loc)",
    code:"Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(!@{value_call __eq__(T,T)->Bool}(a,b,loc));}",
}

extern fn product_less_equal_body<T>(a:T,b:T)->Bool {
    derive:"tuple_le",
    effects:"read_fresh",
    lower:"!@{value_call __lt__(T,T)->Bool}($1,$0,$loc)",
    code:"Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(!@{value_call __lt__(T,T)->Bool}(b,a,loc));}",
}

extern fn product_greater_body<T>(a:T,b:T)->Bool {
    derive:"tuple_gt",
    effects:"read_fresh",
    lower:"@{value_call __lt__(T,T)->Bool}($1,$0,$loc)",
    code:"Obj<bool> @{fn}(Obj<@{T}> a,Obj<@{T}> b,Loc loc){return make_obj<bool>(@{value_call __lt__(T,T)->Bool}(b,a,loc));}",
